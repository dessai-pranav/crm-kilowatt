# ==============================================================================
# Kilowatt AI CRM - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and insert your actual keys and configuration.
#
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM Provider Configuration
# ------------------------------------------------------------------------------
# Provide your Google Gemini API Key from Google AI Studio (https://aistudio.google.com/app/apikey).
# If omitted or left empty, the CRM runs in zero-dependency offline fallback mode
# using deterministic heuristic analysis for summaries, churn scoring, and drafting.
GEMINI_API_KEY=

# (Optional) Alternative OpenAI-compatible key if using OpenAI fallback
# OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Server & Runtime Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Live WooCommerce Store Settings (Optional)
# ------------------------------------------------------------------------------
# By default, the CRM runs in "Mock Sandbox Mode" with realistic demo store data.
# You can connect to a live WooCommerce store either here or via the UI at /settings:
WOOCOMMERCE_URL=https://your-live-woocommerce-store.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key_here
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret_here
WOOCOMMERCE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
